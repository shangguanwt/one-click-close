<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="OneClickClose.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="一键关闭">

    <Window.SystemBackdrop>
        <MicaBackdrop Kind="Base"/>
    </Window.SystemBackdrop>

    <Border Background="{StaticResource WindowGradientBrush}"
            BorderBrush="{StaticResource StrokeBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource WindowRadius}">
        <Grid x:Name="RootGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="248"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid x:Name="AppTitleBar" Grid.ColumnSpan="2" Height="44" VerticalAlignment="Top" Background="Transparent"/>

            <!-- Sidebar matching the reference utility shell. -->
            <Border Grid.Column="0"
                    Background="#AA050B14"
                    BorderBrush="{StaticResource DividerBrush}"
                    BorderThickness="0,0,1,0"
                    Padding="20,28,16,22">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Spacing="14">
                        <Grid Width="56" Height="56" HorizontalAlignment="Left">
                            <Ellipse Fill="{StaticResource PrimaryGradientBrush}"/>
                            <FontIcon Glyph="&#xE945;" FontSize="28" Foreground="White"/>
                        </Grid>
                        <StackPanel Spacing="3">
                            <TextBlock Text="一键关闭" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource TitleTextBrush}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="v1.0.0" FontSize="12" Foreground="{StaticResource SubtleTextBrush}"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Spacing="8">
                        <Button x:Name="OverviewNavButton" Tag="overview" Style="{StaticResource SidebarNavButtonStyle}" Click="SidebarNav_Click">
                            <Grid>
                                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE80F;" FontSize="17" Foreground="White"/>
                                    <TextBlock Text="总览" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="White" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Grid>
                        </Button>
                        <Button x:Name="QuickCloseNavButton" Tag="overview" Style="{StaticResource SidebarNavButtonStyle}" Click="SidebarNav_Click">
                            <Grid>
                                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE945;" FontSize="17" Foreground="White"/>
                                    <TextBlock Text="一键关闭" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="White" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Grid>
                        </Button>
                        <Button x:Name="CandidatesNavButton" Tag="candidates" Style="{StaticResource SidebarNavButtonStyle}" Click="SidebarNav_Click">
                            <Grid>
                                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE9D5;" FontSize="17" Foreground="White"/>
                                    <TextBlock Text="后台进程" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="White" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Grid>
                        </Button>
                        <Button x:Name="ProtectedNavButton" Tag="protected" Style="{StaticResource SidebarNavButtonStyle}" Click="SidebarNav_Click">
                            <Grid>
                                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE72E;" FontSize="17" Foreground="White"/>
                                    <TextBlock Text="白名单" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="White" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Grid>
                        </Button>
                        <Button x:Name="PerformanceNavButton" Tag="performance" Style="{StaticResource SidebarNavButtonStyle}" Click="SidebarNav_Click">
                            <Grid>
                                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE9D2;" FontSize="17" Foreground="White"/>
                                    <TextBlock Text="性能监控" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="White" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Grid>
                        </Button>
                        <Button x:Name="LogsNavButton" Tag="logs" Style="{StaticResource SidebarNavButtonStyle}" Click="SidebarNav_Click">
                            <Grid>
                                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE8FD;" FontSize="17" Foreground="White"/>
                                    <TextBlock Text="清理记录" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="White" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Grid>
                        </Button>
                        <Button x:Name="SettingsNavButton" Tag="settings" Style="{StaticResource SidebarNavButtonStyle}" Click="SidebarNav_Click">
                            <Grid>
                                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE713;" FontSize="17" Foreground="White"/>
                                    <TextBlock Text="设置" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="White" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Grid>
                        </Button>
                    </StackPanel>

                    <Border Grid.Row="3" Background="#660B1726" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="18" Padding="14">
                        <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Grid Width="34" Height="34">
                                    <Ellipse Fill="{StaticResource SafeSoftBrush}"/>
                                    <FontIcon Glyph="&#xE930;" FontSize="16" Foreground="{StaticResource SafeBrush}"/>
                                </Grid>
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="安全模式" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TitleTextBrush}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="仅关闭用户软件" FontSize="11" Foreground="{StaticResource SubtleTextBrush}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Column="1" Background="Transparent">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" MinHeight="88" Padding="30,22,34,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="4" VerticalAlignment="Bottom" MinWidth="0">
                        <TextBlock x:Name="PageTitleText" Text="总览" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource TitleTextBrush}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="PageSubtitleText" Text="快速优化，让电脑保持最佳状态" FontSize="13" Foreground="{StaticResource SubtleTextBrush}" TextWrapping="Wrap" MaxLines="2"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" Margin="0,4,96,0">
                        <Button Style="{StaticResource SubtleButtonStyle}" Padding="12" MinWidth="42" Height="42">
                            <FontIcon Glyph="&#xE721;" FontSize="15"/>
                        </Button>
                        <Button Style="{StaticResource SubtleButtonStyle}" Padding="12" MinWidth="42" Height="42">
                            <FontIcon Glyph="&#xE7ED;" FontSize="15"/>
                        </Button>
                        <Grid Width="42" Height="42">
                            <Ellipse Fill="{StaticResource PrimaryGradientBrush}"/>
                            <TextBlock Text="OC" FontSize="12" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Grid>

                <Frame x:Name="ContentFrame" Grid.Row="1" Padding="0"/>
            </Grid>
        </Grid>
    </Border>
</Window>
