<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="OneClickClose.WinUI.Pages.SystemSlimPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid Padding="4,0" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title + subtitle -->
        <StackPanel Spacing="4">
            <TextBlock Text="系统瘦身" Style="{StaticResource PageTitleStyle}"/>
            <TextBlock Text="识别并管理 Windows 遥测和 AI 后台服务"
                       Foreground="{StaticResource SubtleTextBrush}" FontSize="13"/>
        </StackPanel>

        <!-- Summary cards row -->
        <Grid Grid.Row="1" ColumnSpacing="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 可优化 -->
            <Border Grid.Column="0" Padding="14,12"
                    BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,1,0">
                <StackPanel Spacing="2">
                    <TextBlock Text="可优化" FontSize="11"
                               Foreground="{StaticResource CopperBrush}"/>
                    <TextBlock x:Name="OptimizableCountText" Text="--"
                               Style="{StaticResource MetricNumberStyle}"
                               Foreground="{StaticResource CopperBrush}"/>
                </StackPanel>
            </Border>

            <!-- 已禁用 -->
            <Border Grid.Column="1" Padding="14,12"
                    BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,1,0">
                <StackPanel Spacing="2">
                    <TextBlock Text="已禁用" FontSize="11"
                               Foreground="{StaticResource SafeBrush}"/>
                    <TextBlock x:Name="DisabledCountText" Text="--"
                               Style="{StaticResource MetricNumberStyle}"
                               Foreground="{StaticResource SafeBrush}"/>
                </StackPanel>
            </Border>

            <!-- 运行中 -->
            <Border Grid.Column="2" Padding="14,12">
                <StackPanel Spacing="2">
                    <TextBlock Text="运行中" FontSize="11"
                               Foreground="{StaticResource MutedTextBrush}"/>
                    <TextBlock x:Name="RunningCountText" Text="--"
                               Style="{StaticResource MetricNumberStyle}"
                               Foreground="{StaticResource MutedTextBrush}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Safety warning -->
        <InfoBar Grid.Row="2" IsOpen="True" Severity="Warning"
                 Message="部分服务关闭后可能影响相关功能，请根据提示谨慎操作"/>

        <!-- Loading state -->
        <Border x:Name="LoadingPanel" Grid.Row="2" Background="{StaticResource SurfaceBrush}"
                CornerRadius="10" Padding="16" Visibility="Collapsed"
                BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1">
            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                <ProgressRing IsActive="True" Width="20" Height="20"
                              Foreground="{StaticResource SafeBrush}"/>
                <TextBlock Text="正在扫描遥测服务..." Foreground="{StaticResource BodyTextBrush}"
                           FontSize="13" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Action buttons -->
        <Grid Grid.Row="3" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" x:Name="DisableSafeButton" Click="DisableSafeButton_Click"
                    Style="{StaticResource PrimaryButtonStyle}" Padding="20,10">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE711;" FontSize="13"/>
                    <TextBlock Text="一键禁用安全项"/>
                </StackPanel>
            </Button>

            <Button Grid.Column="1" x:Name="RestoreAllButton" Click="RestoreAllButton_Click"
                    Style="{StaticResource SubtleButtonStyle}" Padding="16,10">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE710;" FontSize="13"/>
                    <TextBlock Text="恢复全部"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- Service list -->
        <ScrollViewer Grid.Row="5" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="3">
                <ItemsControl x:Name="ServiceList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8"
                                    Padding="16,12" Margin="0,0,0,3"
                                    BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Toggle switch -->
                                    <ToggleSwitch Grid.Column="0" VerticalAlignment="Center"
                                                  OnContent="" OffContent=""
                                                  IsOn="{Binding SwitchIsOn, Mode=TwoWay}"
                                                  Toggled="ServiceToggle_Toggled" Tag="{Binding}"/>

                                    <!-- Service name + description -->
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayName}"
                                                   Foreground="{StaticResource TitleTextBrush}"
                                                   FontSize="13" FontWeight="Medium"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Description}"
                                                   Foreground="{StaticResource SubtleTextBrush}"
                                                   FontSize="11" TextTrimming="CharacterEllipsis"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>

                                    <!-- Risk badge -->
                                    <Border Grid.Column="2" CornerRadius="4" Padding="8,3"
                                            Background="{Binding RiskBadgeBackground}"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding RiskBadgeText}"
                                                   FontSize="11" FontWeight="Medium"
                                                   Foreground="{Binding RiskBadgeForeground}"/>
                                    </Border>

                                    <!-- Status badge -->
                                    <Border Grid.Column="3" CornerRadius="4" Padding="8,3"
                                            Background="{Binding StatusBadgeBackground}"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding StatusBadgeText}"
                                                   FontSize="11" FontWeight="Medium"
                                                   Foreground="{Binding StatusBadgeForeground}"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Empty state -->
                <Border x:Name="EmptyState" Background="{StaticResource SurfaceBrush}"
                        CornerRadius="12" Padding="40" HorizontalAlignment="Stretch"
                        BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1">
                    <StackPanel Spacing="6" HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE9D5;" FontSize="36"
                                  Foreground="{StaticResource EmptyIconBrush}"
                                  HorizontalAlignment="Center"/>
                        <TextBlock x:Name="EmptyText" Text="正在加载服务列表..."
                                   Foreground="{StaticResource SubtleTextBrush}" FontSize="13"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
