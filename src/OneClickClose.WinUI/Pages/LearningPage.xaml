<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="OneClickClose.WinUI.Pages.LearningPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <ScrollViewer>
        <StackPanel Spacing="16" Padding="8" MaxWidth="800">
            <StackPanel Spacing="4">
                <TextBlock Text="学习建议" Style="{StaticResource PageTitleStyle}"/>
                <TextBlock Text="基于你的使用习惯，系统会智能推荐优化配置" FontSize="14"
                           Foreground="{StaticResource MutedTextBrush}"/>
            </StackPanel>

            <!-- Suggestions -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="配置建议" Style="{StaticResource SectionTitleStyle}"/>
                    <ItemsControl x:Name="SuggestionsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource SurfaceElevatedBrush}" CornerRadius="8"
                                        BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1"
                                        Padding="16,12" Margin="0,0,0,6">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Style="{StaticResource TagBadgeStyle}"
                                                Background="{Binding TypeBg}" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Type}" Foreground="{StaticResource BodyTextBrush}" FontSize="11"/>
                                        </Border>

                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ProcessName}"
                                                       Foreground="{StaticResource TitleTextBrush}"
                                                       FontSize="14" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Reason}"
                                                       Foreground="{StaticResource MutedTextBrush}" FontSize="12"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>

                                        <Button Grid.Column="2" Content="应用" Click="ApplySuggestion_Click"
                                                Tag="{Binding}" CornerRadius="6" Padding="12,6"
                                                Background="{StaticResource SafeBrush}" Foreground="White"
                                                FontSize="12"/>

                                        <Button Grid.Column="3" Content="忽略" Click="IgnoreSuggestion_Click"
                                                Tag="{Binding}" CornerRadius="6" Padding="12,6"
                                                FontSize="12"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel x:Name="NoSuggestionsPanel" Spacing="8" HorizontalAlignment="Center" Padding="40">
                        <FontIcon Glyph="&#xE946;" FontSize="40" Foreground="{StaticResource EmptyIconBrush}"
                                  HorizontalAlignment="Center"/>
                        <TextBlock x:Name="NoSuggestionsText" Text="暂无建议。使用更多后系统会生成个性化建议。"
                                   Foreground="{StaticResource MutedTextBrush}" FontSize="14"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Info -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Text="建议机制" Style="{StaticResource SubTitleStyle}"/>
                    <TextBlock FontSize="13" Foreground="{StaticResource BodyTextBrush}" TextWrapping="Wrap">
                        <Run Text="保护名单建议："/>
                        <Run Text="当你手动移除某个进程超过 3 次时，系统会建议将其加入保护名单。"
                             Foreground="{StaticResource MutedTextBrush}"/>
                    </TextBlock>
                    <TextBlock FontSize="13" Foreground="{StaticResource BodyTextBrush}" TextWrapping="Wrap">
                        <Run Text="强制清理建议："/>
                        <Run Text="当某进程最近 3 次都需要强制终止时，系统会建议将其加入强制清理名单。"
                             Foreground="{StaticResource MutedTextBrush}"/>
                    </TextBlock>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
