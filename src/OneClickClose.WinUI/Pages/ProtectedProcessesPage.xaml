<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="OneClickClose.WinUI.Pages.ProtectedProcessesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid Padding="8" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="12">
            <TextBlock Text="保护进程" Style="{StaticResource PageTitleStyle}"/>
            <Border x:Name="CountBadge" Background="{StaticResource SafeSoftBrush}" CornerRadius="4" Padding="8,3"
                    VerticalAlignment="Center" Visibility="Collapsed">
                <TextBlock x:Name="CountText" Foreground="{StaticResource SafeBrush}" FontSize="12" FontWeight="SemiBold"/>
            </Border>
        </StackPanel>

        <!-- Search bar -->
        <TextBox x:Name="SearchBox" Grid.Row="1" PlaceholderText="搜索保护进程..." TextChanged="SearchBox_TextChanged"
                 FontSize="13" CornerRadius="8"/>

        <!-- Header bar -->
        <Border Grid.Row="2" Style="{StaticResource HeaderBarStyle}">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="进程" Style="{StaticResource ColumnHeaderStyle}"/>
                <TextBlock Grid.Column="1" Text="原因" Style="{StaticResource ColumnHeaderStyle}"/>
                <TextBlock Grid.Column="2" Text="数量" Style="{StaticResource ColumnHeaderStyle}"/>
                <TextBlock Grid.Column="3" Text="内存" Style="{StaticResource ColumnHeaderStyle}"/>
            </Grid>
        </Border>

        <!-- Process list -->
        <ScrollViewer Grid.Row="3">
            <ItemsControl x:Name="ProcessList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8"
                                BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1"
                                Padding="16,12" Margin="0,0,0,4">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Process name -->
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="{Binding Process}"
                                               Foreground="{StaticResource TitleTextBrush}"
                                               FontSize="14" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Note}"
                                               Foreground="{StaticResource SubtleTextBrush}"
                                               FontSize="11" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>

                                <!-- Reason badge (low-saturation tag) -->
                                <Border Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource TagBadgeStyle}"
                                        Background="{StaticResource SafeSoftBrush}">
                                    <TextBlock Text="{Binding Action}"
                                               Foreground="{StaticResource SafeBrush}" FontSize="11"/>
                                </Border>

                                <!-- Count -->
                                <TextBlock Grid.Column="2" Text="{Binding Count}"
                                           Foreground="{StaticResource BodyTextBrush}" FontSize="14"
                                           VerticalAlignment="Center"/>

                                <!-- Memory -->
                                <TextBlock Grid.Column="3" Text="{Binding MemoryText}"
                                           Foreground="{StaticResource MutedTextBrush}" FontSize="13"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Empty state -->
        <Border x:Name="EmptyState" Grid.Row="3" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1"
                CornerRadius="12" Padding="40" HorizontalAlignment="Stretch" VerticalAlignment="Top">
            <StackPanel Spacing="8" HorizontalAlignment="Center">
                <FontIcon Glyph="&#xE72E;" FontSize="40" Foreground="{StaticResource EmptyIconBrush}"
                          HorizontalAlignment="Center"/>
                <TextBlock x:Name="EmptyText" Text="点击「扫描进程」查看保护列表"
                           Foreground="{StaticResource MutedTextBrush}" FontSize="14"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- No results state -->
        <Border x:Name="NoResultsState" Grid.Row="3" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1"
                CornerRadius="12" Padding="40" HorizontalAlignment="Stretch" VerticalAlignment="Top"
                Visibility="Collapsed">
            <StackPanel Spacing="8" HorizontalAlignment="Center">
                <FontIcon Glyph="&#xE721;" FontSize="40" Foreground="{StaticResource EmptyIconBrush}"
                          HorizontalAlignment="Center"/>
                <TextBlock Text="没有匹配的保护进程" Foreground="{StaticResource MutedTextBrush}"
                           FontSize="14" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
