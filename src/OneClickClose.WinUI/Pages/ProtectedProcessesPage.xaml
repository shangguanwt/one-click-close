<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="OneClickClose.WinUI.Pages.ProtectedProcessesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid Padding="4,0" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Padding="14">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.4*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="SearchBox"
                         PlaceholderText="搜索受保护应用、路径或原因..."
                         TextChanged="SearchBox_TextChanged"
                         Style="{StaticResource SubtleTextBoxStyle}"
                         MinHeight="40"/>

                <Border Grid.Column="1"
                        Style="{StaticResource HeroProcessBadgeStyle}"
                        Padding="10,6"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <FontIcon Glyph="&#xE72E;" FontSize="13" Foreground="{StaticResource SafeBrush}"/>
                        <TextBlock Text="白名单仅保存在本机" Foreground="{StaticResource BodyTextBrush}" FontSize="12" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Button Grid.Column="2"
                        Click="AddProtected_Click"
                        Style="{StaticResource SubtleButtonStyle}"
                        MinHeight="40"
                        Padding="18,8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE710;" FontSize="14" Foreground="{StaticResource AccentLightBrush}"/>
                        <TextBlock Text="添加应用" Foreground="{StaticResource BodyTextBrush}" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>

                <Button Grid.Column="3"
                        Click="ImportRules_Click"
                        Style="{StaticResource SubtleButtonStyle}"
                        MinHeight="40"
                        Padding="18,8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8B5;" FontSize="14" Foreground="{StaticResource BodyTextBrush}"/>
                        <TextBlock Text="导入规则" Foreground="{StaticResource BodyTextBrush}" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <Grid Grid.Row="1">

            <Border Style="{StaticResource CardBorderStyle}" Padding="0">
                <Grid RowSpacing="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Padding="20,13" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2.1*"/>
                                <ColumnDefinition Width="2.2*"/>
                                <ColumnDefinition Width="1.05*"/>
                                <ColumnDefinition Width="0.75*"/>
                                <ColumnDefinition Width="0.9*"/>
                                <ColumnDefinition Width="70"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="应用名" Style="{StaticResource ColumnHeaderStyle}"/>
                                <Border x:Name="CountBadge"
                                        Background="{StaticResource SafeSoftBrush}"
                                        CornerRadius="7"
                                        Padding="8,2"
                                        VerticalAlignment="Center"
                                        Visibility="Collapsed">
                                    <TextBlock x:Name="CountText" Foreground="{StaticResource SafeBrush}" FontSize="11" FontWeight="SemiBold"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="路径" Style="{StaticResource ColumnHeaderStyle}"/>
                            <TextBlock Grid.Column="2" Text="保护原因" Style="{StaticResource ColumnHeaderStyle}" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Text="数量" Style="{StaticResource ColumnHeaderStyle}" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="4" Text="内存" Style="{StaticResource ColumnHeaderStyle}" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="5" Text="操作" Style="{StaticResource ColumnHeaderStyle}" HorizontalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1">
                        <ListView x:Name="ProcessList"
                                  HorizontalAlignment="Stretch"
                                  SelectionMode="None"
                                  IsItemClickEnabled="False"
                                  HorizontalContentAlignment="Stretch"
                                  ScrollViewer.HorizontalScrollMode="Disabled"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  ContainerContentChanging="ProcessList_ContainerContentChanging">
                            <ListView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsStackPanel Orientation="Vertical"/>
                                </ItemsPanelTemplate>
                            </ListView.ItemsPanel>
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0"/>
                                    <Setter Property="MinHeight" Value="0"/>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource SurfaceBrush}"
                                                BorderBrush="{StaticResource DividerBrush}"
                                                BorderThickness="0,0,0,1"
                                                Padding="20,12"
                                                HorizontalAlignment="Stretch">
                                            <Grid ColumnSpacing="14">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="2.1*"/>
                                                    <ColumnDefinition Width="2.2*"/>
                                                    <ColumnDefinition Width="1.05*"/>
                                                    <ColumnDefinition Width="0.75*"/>
                                                    <ColumnDefinition Width="0.9*"/>
                                                    <ColumnDefinition Width="70"/>
                                                </Grid.ColumnDefinitions>

                                                <Grid ColumnSpacing="12" MinWidth="0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Grid Width="36" Height="36" VerticalAlignment="Center">
                                                        <Grid Visibility="{Binding FallbackIconVisibility}">
                                                            <Border Background="{Binding IconBackground}" CornerRadius="8"/>
                                                            <FontIcon Glyph="{Binding IconGlyph}" FontSize="14" Foreground="{Binding IconForeground}"/>
                                                        </Grid>
                                                        <Image Source="{Binding IconSource}" Visibility="{Binding IconImageVisibility}" Width="28" Height="28" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Grid>
                                                    <StackPanel Grid.Column="1" Spacing="3" MinWidth="0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Process}" Foreground="{StaticResource TitleTextBrush}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding SummaryLine}" Foreground="{StaticResource SubtleTextBrush}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </Grid>

                                                <TextBlock Grid.Column="1" Text="{Binding PathText}" Foreground="{StaticResource MutedTextBrush}" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>

                                                <Border Grid.Column="2"
                                                        Background="{Binding ReasonBadgeBackground}"
                                                        CornerRadius="10"
                                                        Padding="8,4"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding ReasonText}" Foreground="{Binding ReasonForeground}" FontSize="11" FontWeight="SemiBold"/>
                                                </Border>

                                                <TextBlock Grid.Column="3" Text="{Binding CountText}" Foreground="{StaticResource BodyTextBrush}" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="4" Text="{Binding MemoryText}" Foreground="{StaticResource MutedTextBrush}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                                <Button Grid.Column="5"
                                                        Style="{StaticResource SubtleButtonStyle}"
                                                        Width="34"
                                                        Height="30"
                                                        MinWidth="34"
                                                        Padding="0"
                                                        HorizontalAlignment="Center"
                                                        ToolTipService.ToolTip="更多操作">
                                                    <Button.Content>
                                                        <FontIcon Glyph="&#xE712;" FontSize="14" Foreground="{StaticResource BodyTextBrush}"/>
                                                    </Button.Content>
                                                    <Button.Flyout>
                                                        <MenuFlyout>
                                                            <MenuFlyoutItem Text="查看详情" Click="ShowProtectedDetails_Click" Tag="{Binding}"/>
                                                        </MenuFlyout>
                                                    </Button.Flyout>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                            <Border x:Name="EmptyState"
                                    Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource StrokeBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="40"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Top">
                                <StackPanel Spacing="8" HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xE72E;" FontSize="40" Foreground="{StaticResource EmptyIconBrush}" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="EmptyText" Text="点击“重新扫描”查看保护列表" Foreground="{StaticResource MutedTextBrush}" FontSize="14" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <Border x:Name="NoResultsState"
                                    Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource StrokeBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="40"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Top"
                                    Visibility="Collapsed">
                                <StackPanel Spacing="8" HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xE721;" FontSize="40" Foreground="{StaticResource EmptyIconBrush}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="没有匹配的保护进程" Foreground="{StaticResource MutedTextBrush}" FontSize="14" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                    </Grid>

                    <Border Grid.Row="2" Padding="20,12" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0">
                        <TextBlock x:Name="FooterText" Text="共 0 项受保护应用" Foreground="{StaticResource MutedTextBrush}" FontSize="12"/>
                    </Border>
                </Grid>
            </Border>

        </Grid>

        <Grid Grid.Row="2" ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource CardBorderStyle}" Padding="18">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE823;" FontSize="20" Foreground="{StaticResource AccentLightBrush}"/>
                        <TextBlock Text="最近被保护的项目" Foreground="{StaticResource TitleTextBrush}" FontSize="16" FontWeight="SemiBold"/>
                    </StackPanel>
                    <ItemsControl x:Name="RecentProtectedList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnSpacing="10" Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid Width="32" Height="32" VerticalAlignment="Center">
                                        <Grid Visibility="{Binding FallbackIconVisibility}">
                                            <Border Background="{Binding IconBackground}" CornerRadius="8"/>
                                            <FontIcon Glyph="{Binding IconGlyph}" FontSize="13" Foreground="{Binding IconForeground}"/>
                                        </Grid>
                                        <Image Source="{Binding IconSource}" Visibility="{Binding IconImageVisibility}" Width="24" Height="24" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Text="{Binding Process}" Foreground="{StaticResource BodyTextBrush}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding SummaryLine}" Foreground="{StaticResource SubtleTextBrush}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="RecentEmptyText" Text="暂无最近保护项目" Foreground="{StaticResource SubtleTextBrush}" FontSize="12" Visibility="Collapsed"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Padding="18">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE734;" FontSize="20" Foreground="{StaticResource AccentLightBrush}"/>
                        <TextBlock Text="建议加入白名单" Foreground="{StaticResource TitleTextBrush}" FontSize="16" FontWeight="SemiBold"/>
                    </StackPanel>
                    <TextBlock Text="根据高风险和常驻应用推荐保护以下项目" Foreground="{StaticResource SubtleTextBrush}" FontSize="12"/>
                    <ItemsControl x:Name="SuggestedProtectList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnSpacing="12" Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid Width="32" Height="32" VerticalAlignment="Center">
                                        <Grid Visibility="{Binding FallbackIconVisibility}">
                                            <Border Background="{Binding IconBackground}" CornerRadius="8"/>
                                            <FontIcon Glyph="{Binding IconGlyph}" FontSize="13" Foreground="{Binding IconForeground}"/>
                                        </Grid>
                                        <Image Source="{Binding IconSource}" Visibility="{Binding IconImageVisibility}" Width="24" Height="24" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                    <StackPanel Grid.Column="1" Spacing="2" MinWidth="0">
                                        <TextBlock Text="{Binding Process}" Foreground="{StaticResource BodyTextBrush}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding DetailLine}" Foreground="{StaticResource SubtleTextBrush}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <Button Grid.Column="2" Content="加入" Tag="{Binding}" Click="AddSuggestionToProtected_Click" Style="{StaticResource SubtleButtonStyle}" Padding="16,7"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="SuggestionEmptyText" Text="暂无需要建议保护的应用" Foreground="{StaticResource SubtleTextBrush}" FontSize="12" Visibility="Collapsed"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
