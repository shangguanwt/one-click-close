<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="OneClickClose.WinUI.Pages.OverviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:OneClickClose.WinUI.Controls"
    Background="Transparent"
    SizeChanged="OverviewPage_SizeChanged">

    <Grid>
        <ScrollViewer HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="PageStack" Spacing="18" Padding="30,0,34,32">

                <Grid x:Name="HardwareGrid" ColumnSpacing="12" RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border x:Name="CpuChipCard" Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="14,12" CornerRadius="18" MinHeight="66">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid Width="34" Height="34">
                                <Ellipse Fill="{StaticResource CyanSoftBrush}"/>
                                <FontIcon Glyph="&#xE9D5;" FontSize="15" Foreground="{StaticResource AccentLightBrush}"/>
                            </Grid>
                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center" MinWidth="0">
                                <TextBlock Text="CPU" FontSize="11" Foreground="{StaticResource SubtleTextBrush}"/>
                                <TextBlock x:Name="CpuChipText" Text="--%" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TitleTextBrush}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <controls:SparklineControl x:Name="CpuChipSparkline" Grid.Column="2" Width="72" Height="30" LineColor="{StaticResource AccentLightBrush}" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <Border x:Name="MemoryChipCard" Grid.Column="1" Style="{StaticResource CardBorderStyle}" Padding="14,12" CornerRadius="18" MinHeight="66">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid Width="34" Height="34">
                                <Ellipse Fill="{StaticResource PurpleSoftBrush}"/>
                                <FontIcon Glyph="&#xE950;" FontSize="15" Foreground="{StaticResource PurpleBrush}"/>
                            </Grid>
                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center" MinWidth="0">
                                <TextBlock Text="内存" FontSize="11" Foreground="{StaticResource SubtleTextBrush}"/>
                                <TextBlock x:Name="MemoryChipText" Text="-- / -- GB" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TitleTextBrush}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <controls:SparklineControl x:Name="MemoryChipSparkline" Grid.Column="2" Width="72" Height="30" LineColor="{StaticResource PurpleBrush}" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <Border x:Name="TempChipCard" Grid.Column="2" Style="{StaticResource CardBorderStyle}" Padding="14,12" CornerRadius="18" MinHeight="66">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid Width="34" Height="34">
                                <Ellipse Fill="{StaticResource CopperSoftBrush}"/>
                                <FontIcon Glyph="&#xE1D6;" FontSize="15" Foreground="{StaticResource CopperBrush}"/>
                            </Grid>
                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center" MinWidth="0">
                                <TextBlock Text="温度" FontSize="11" Foreground="{StaticResource SubtleTextBrush}"/>
                                <TextBlock x:Name="TempChipText" Text="--°C" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TitleTextBrush}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <controls:SparklineControl x:Name="TempChipSparkline" Grid.Column="2" Width="72" Height="30" LineColor="{StaticResource CopperBrush}" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <Border x:Name="BatteryChipCard" Grid.Column="3" Style="{StaticResource CardBorderStyle}" Padding="14,12" CornerRadius="18" MinHeight="66">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid Width="34" Height="34">
                                <Ellipse Fill="{StaticResource SafeSoftBrush}"/>
                                <FontIcon Glyph="&#xE83F;" FontSize="15" Foreground="{StaticResource SafeBrush}"/>
                            </Grid>
                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center" MinWidth="0">
                                <TextBlock Text="电池" FontSize="11" Foreground="{StaticResource SubtleTextBrush}"/>
                                <TextBlock x:Name="BatteryChipText" Text="--%" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TitleTextBrush}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <controls:SparklineControl x:Name="BatteryChipSparkline" Grid.Column="2" Width="72" Height="30" LineColor="{StaticResource SafeBrush}" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </Grid>
                <Border Style="{StaticResource ElevatedCardStyle}" MinHeight="304">
                    <Grid x:Name="HeroGrid" ColumnSpacing="24" RowSpacing="20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.22*"/>
                            <ColumnDefinition Width="280"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <Grid x:Name="HeroCopyPanel" Grid.Column="0" VerticalAlignment="Stretch" MinWidth="0">
                            <StackPanel Spacing="18" VerticalAlignment="Center">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="释放后台进程" Style="{StaticResource HeroTitleStyle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="让电脑恢复最佳状态" Style="{StaticResource HeroTitleStyle}" Foreground="{StaticResource MutedTextBrush}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <StackPanel Spacing="8" MinWidth="0">
                                    <TextBlock x:Name="StatusHeadline" Text="正在准备扫描" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource BodyTextBrush}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="HeroInsightText" Text="已检测到 0 个可优化项目 / 预计释放 0 MB 内存" FontSize="13" Foreground="{StaticResource SubtleTextBrush}" TextWrapping="Wrap" MaxLines="2"/>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{StaticResource SubtleTextBrush}" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="ScanTimeText" Text="等待扫描" FontSize="12" Foreground="{StaticResource SubtleTextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel x:Name="PrimaryActionsPanel" Orientation="Horizontal" Spacing="12">
                                    <Button x:Name="OptimizeButton" Style="{StaticResource PrimaryButtonStyle}" Click="CloseAllButton_Click" IsEnabled="False" MinHeight="52" MinWidth="150">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <Grid Width="24" Height="24">
                                                <Ellipse Fill="#33FFFFFF"/>
                                                <FontIcon Glyph="&#xE945;" FontSize="14" Foreground="White"/>
                                            </Grid>
                                            <TextBlock Text="立即优化" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="ScanButton" Style="{StaticResource SubtleButtonStyle}" Click="ScanButton_Click" MinHeight="52" MinWidth="132">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE72C;" FontSize="15"/>
                                            <TextBlock Text="重新扫描" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="CancelCloseButton" Content="取消" Style="{StaticResource SubtleButtonStyle}" Click="CancelCloseButton_Click" Visibility="Collapsed" MinHeight="52" MinWidth="88"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <Grid x:Name="MemoryHalo" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Width="246" Height="246">
                            <Ellipse Fill="#16000000"/>
                            <Ellipse Width="224" Height="224" Stroke="#172A42" StrokeThickness="1"/>
                            <controls:MemoryRingControl x:Name="MemoryRing" Value="0" UsedText="0 / 0 GB"/>
                        </Grid>

                        <Border x:Name="PerformancePanel" Grid.Column="2" Background="#660B1726" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="18" Padding="18" MinWidth="0">
                            <StackPanel Spacing="18" VerticalAlignment="Center">
                                <TextBlock Text="性能监控" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TitleTextBrush}" TextTrimming="CharacterEllipsis"/>
                                <Grid ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="62"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="64"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="CPU" FontSize="12" Foreground="{StaticResource SubtleTextBrush}" VerticalAlignment="Center"/>
                                    <controls:SparklineControl x:Name="CpuSparkline" Grid.Column="1" Height="38" LineColor="{StaticResource AccentLightBrush}"/>
                                    <TextBlock x:Name="CpuPercentText" Grid.Column="2" Text="0.0%" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TitleTextBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis"/>
                                </Grid>
                                <Grid ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="62"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="64"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="GPU" FontSize="12" Foreground="{StaticResource SubtleTextBrush}" VerticalAlignment="Center"/>
                                    <controls:SparklineControl x:Name="GpuSparkline" Grid.Column="1" Height="38" LineColor="{StaticResource PurpleBrush}"/>
                                    <TextBlock x:Name="GpuValueText" Grid.Column="2" Text="--" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TitleTextBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis"/>
                                </Grid>
                                <Grid ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="62"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="64"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Disk" FontSize="12" Foreground="{StaticResource SubtleTextBrush}" VerticalAlignment="Center"/>
                                    <controls:SparklineControl x:Name="DiskSparkline" Grid.Column="1" Height="38" LineColor="{StaticResource CopperBrush}"/>
                                    <TextBlock x:Name="DiskValueText" Grid.Column="2" Text="0.0%" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TitleTextBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis"/>
                                </Grid>
                                <Grid ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="62"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="92"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Network" FontSize="12" Foreground="{StaticResource SubtleTextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <controls:SparklineControl x:Name="NetworkSparkline" Grid.Column="1" Height="38" LineColor="{StaticResource SafeBrush}"/>
                                    <TextBlock x:Name="NetworkValueText" Grid.Column="2" Text="0 KB/s" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TitleTextBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
                <Grid x:Name="MetricsInner" ColumnSpacing="14" RowSpacing="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border x:Name="MetricCandidatesCard" Grid.Column="0" Style="{StaticResource MetricCardStyle}">
                        <Grid>
                            <StackPanel Spacing="8">
                                <Grid Width="42" Height="42" HorizontalAlignment="Left">
                                    <Ellipse Fill="{StaticResource CyanSoftBrush}"/>
                                    <FontIcon Glyph="&#xE8A7;" FontSize="18" Foreground="{StaticResource AccentLightBrush}"/>
                                </Grid>
                                <TextBlock Text="待关闭" FontSize="13" Foreground="{StaticResource SubtleTextBrush}"/>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock x:Name="TotalCountText" Text="0" Style="{StaticResource MetricNumberStyle}"/>
                                    <TextBlock x:Name="TrendCandidates" Text="--" FontSize="12" Foreground="{StaticResource SafeBrush}" VerticalAlignment="Bottom" Margin="0,0,0,8" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <TextBlock x:Name="TotalCountHint" Text="可优化项目" FontSize="12" Foreground="{StaticResource SubtleTextBrush}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border x:Name="MetricMemoryCard" Grid.Column="1" Style="{StaticResource MetricCardStyle}">
                        <StackPanel Spacing="8">
                            <Grid Width="42" Height="42" HorizontalAlignment="Left">
                                <Ellipse Fill="{StaticResource PurpleSoftBrush}"/>
                                <FontIcon Glyph="&#xE950;" FontSize="18" Foreground="{StaticResource PurpleBrush}"/>
                            </Grid>
                            <TextBlock Text="预计释放" FontSize="13" Foreground="{StaticResource SubtleTextBrush}"/>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock x:Name="MemoryEstimateText" Text="0 MB" Style="{StaticResource MetricNumberStyle}"/>
                                <TextBlock x:Name="TrendMemory" Text="--" FontSize="12" Foreground="{StaticResource SafeBrush}" VerticalAlignment="Bottom" Margin="0,0,0,8" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <TextBlock x:Name="MemoryEstimateHint" Text="可释放内存" FontSize="12" Foreground="{StaticResource SubtleTextBrush}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Border>

                    <Border x:Name="MetricBackgroundCard" Grid.Column="2" Style="{StaticResource MetricCardStyle}">
                        <StackPanel Spacing="8">
                            <Grid Width="42" Height="42" HorizontalAlignment="Left">
                                <Ellipse Fill="{StaticResource SafeSoftBrush}"/>
                                <FontIcon Glyph="&#xE9D5;" FontSize="18" Foreground="{StaticResource SafeBrush}"/>
                            </Grid>
                            <TextBlock Text="后台软件" FontSize="13" Foreground="{StaticResource SubtleTextBrush}"/>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock x:Name="GracefulCountText" Text="0" Style="{StaticResource MetricNumberStyle}"/>
                                <TextBlock x:Name="TrendBackground" Text="--" FontSize="12" Foreground="{StaticResource SafeBrush}" VerticalAlignment="Bottom" Margin="0,0,0,8" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <TextBlock Text="温和关闭项" FontSize="12" Foreground="{StaticResource SubtleTextBrush}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Border>

                    <Border x:Name="MetricStartupCard" Grid.Column="3" Style="{StaticResource MetricCardStyle}">
                        <StackPanel Spacing="8">
                            <Grid Width="42" Height="42" HorizontalAlignment="Left">
                                <Ellipse Fill="{StaticResource CopperSoftBrush}"/>
                                <FontIcon Glyph="&#xE7F4;" FontSize="18" Foreground="{StaticResource CopperBrush}"/>
                            </Grid>
                            <TextBlock Text="启动项" FontSize="13" Foreground="{StaticResource SubtleTextBrush}"/>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock x:Name="ProtectedCountText" Text="0" Style="{StaticResource MetricNumberStyle}"/>
                                <TextBlock x:Name="TrendStartup" Text="--" FontSize="12" Foreground="{StaticResource SafeBrush}" VerticalAlignment="Bottom" Margin="0,0,0,8" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <TextBlock Text="开机启动" FontSize="12" Foreground="{StaticResource SubtleTextBrush}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Border>
                </Grid>
                <Border x:Name="ProcessTableBorder" Style="{StaticResource CardBorderStyle}" Padding="0" Visibility="Collapsed">
                    <StackPanel>
                        <Grid x:Name="ProcessToolbar" Padding="22,20,22,14" ColumnSpacing="12" RowSpacing="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="260"/>
                                <ColumnDefinition Width="132"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel x:Name="ProcessTitleGroup" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" MinWidth="0">
                                <TextBlock x:Name="ProcessTableTitle" Text="后台进程 (0)" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TitleTextBrush}" TextTrimming="CharacterEllipsis"/>
                                <Border Background="{StaticResource CyanSoftBrush}" CornerRadius="10" Padding="8,3" VerticalAlignment="Center">
                                    <TextBlock Text="实时" FontSize="11" Foreground="{StaticResource AccentLightBrush}"/>
                                </Border>
                            </StackPanel>
                            <TextBox Grid.Column="1" x:Name="SearchBox" Style="{StaticResource SubtleTextBoxStyle}" PlaceholderText="搜索进程..." TextChanged="SearchBox_TextChanged"/>
                            <ComboBox Grid.Column="2" x:Name="FilterCombo" SelectionChanged="FilterCombo_SelectionChanged" HorizontalAlignment="Stretch" SelectedIndex="0">
                                <ComboBoxItem Content="全部"/>
                                <ComboBoxItem Content="可关闭"/>
                                <ComboBoxItem Content="需强制"/>
                                <ComboBoxItem Content="高风险"/>
                            </ComboBox>
                        </Grid>

                        <ScrollViewer HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Auto" VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
                            <StackPanel MinWidth="820">
                                <Border Padding="22,10" Background="#660B1726" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,1">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="96"/>
                                            <ColumnDefinition Width="64"/>
                                            <ColumnDefinition Width="92"/>
                                            <ColumnDefinition Width="104"/>
                                            <ColumnDefinition Width="84"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="进程名称" Style="{StaticResource ColumnHeaderStyle}"/>
                                        <TextBlock Grid.Column="1" Text="内存占用" Style="{StaticResource ColumnHeaderStyle}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="2" Text="CPU" Style="{StaticResource ColumnHeaderStyle}"/>
                                        <TextBlock Grid.Column="3" Text="状态" Style="{StaticResource ColumnHeaderStyle}"/>
                                        <TextBlock Grid.Column="4" Text="建议" Style="{StaticResource ColumnHeaderStyle}"/>
                                        <TextBlock Grid.Column="5" Text="操作" Style="{StaticResource ColumnHeaderStyle}"/>
                                    </Grid>
                                </Border>

                                <ListView x:Name="ProcessTableList" SelectionMode="None" IsItemClickEnabled="False" Background="Transparent" BorderThickness="0" MaxHeight="330">
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="MinHeight" Value="64"/>
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="Margin" Value="0"/>
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1" Padding="22,9">
                                                <Grid ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="96"/>
                                                        <ColumnDefinition Width="64"/>
                                                        <ColumnDefinition Width="92"/>
                                                        <ColumnDefinition Width="104"/>
                                                        <ColumnDefinition Width="84"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Grid Grid.Column="0" ColumnSpacing="12" VerticalAlignment="Center" MinWidth="0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Grid Width="34" Height="34">
                                                            <Ellipse Fill="{Binding IconBg}"/>
                                                            <FontIcon Glyph="{Binding IconGlyph}" FontSize="15" Foreground="{Binding IconFg}"/>
                                                        </Grid>
                                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center" MinWidth="0">
                                                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TitleTextBrush}" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{StaticResource SubtleTextBrush}" TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                    </Grid>
                                                    <TextBlock Grid.Column="1" Text="{Binding Memory}" FontSize="13" Foreground="{StaticResource BodyTextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding Cpu}" FontSize="13" Foreground="{StaticResource BodyTextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                                        <Ellipse Width="8" Height="8" Fill="{Binding StatusDot}"/>
                                                        <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="{StaticResource MutedTextBrush}" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                    <Border Grid.Column="4" Background="{Binding ActionBg}" CornerRadius="12" Padding="10,5" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Suggestion}" FontSize="12" FontWeight="SemiBold" Foreground="{Binding SuggestionFg}" TextTrimming="CharacterEllipsis"/>
                                                    </Border>
                                                    <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                        <Button Content="关闭" Tag="{Binding Id}" Click="CloseProcess_Click" Style="{StaticResource TableActionButtonStyle}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </ScrollViewer>

                        <TextBlock x:Name="TopEmptyText" Text="暂无后台进程" FontSize="13" Foreground="{StaticResource SubtleTextBrush}" HorizontalAlignment="Center" Margin="0,22" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>

                <StackPanel x:Name="LoadingPanel" Orientation="Horizontal" Spacing="12" Visibility="Collapsed" HorizontalAlignment="Center">
                    <ProgressRing IsActive="True" Width="24" Height="24"/>
                    <TextBlock Text="正在扫描..." FontSize="14" Foreground="{StaticResource BodyTextBrush}" VerticalAlignment="Center"/>
                </StackPanel>

                <InfoBar x:Name="ErrorBar" Visibility="Collapsed" IsOpen="False" Severity="Error"/>
                <InfoBar x:Name="ResultBar" Visibility="Collapsed" IsOpen="False" Severity="Success"/>

                <Border x:Name="ExecProgressPanel" Style="{StaticResource CardBorderStyle}" Padding="18,14" Visibility="Collapsed">
                    <StackPanel Spacing="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="ExecStatusText" Text="正在执行..." FontSize="13" Foreground="{StaticResource BodyTextBrush}" TextTrimming="CharacterEllipsis"/>
                            <ProgressRing x:Name="ExecProgress" Grid.Column="1" IsActive="True" Width="20" Height="20"/>
                        </Grid>
                        <ProgressBar x:Name="CleanupProgressBar" IsIndeterminate="True" Height="4"/>
                    </StackPanel>
                </Border>

                <StackPanel Visibility="Collapsed">
                    <TextBlock x:Name="LogCountText" Text="" FontSize="12" Foreground="{StaticResource SubtleTextBrush}" Margin="0,0,0,8"/>
                    <ListView x:Name="LogList" SelectionMode="None" IsItemClickEnabled="False" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="6" Background="{StaticResource SurfaceBrush}" Padding="4">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Text}" Foreground="{Binding Color}" FontFamily="Cascadia Code,Consolas" FontSize="12" Margin="8,2" TextTrimming="CharacterEllipsis"/>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>