<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="OneClickClose.WinUI.Pages.LogsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid Padding="8" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="12">
            <TextBlock Text="运行日志" Style="{StaticResource PageTitleStyle}"/>
            <Border x:Name="HistoryCountBadge" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1"
                    CornerRadius="4" Padding="8,3" VerticalAlignment="Center" Visibility="Collapsed">
                <TextBlock x:Name="HistoryCountText" Foreground="{StaticResource MutedTextBrush}" FontSize="11"/>
            </Border>
        </StackPanel>

        <!-- Tabs -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="4">
            <Button x:Name="CurrentLogBtn" Content="本次执行" Click="CurrentLogBtn_Click"
                    CornerRadius="8" Padding="16,8" FontWeight="SemiBold" FontSize="13"/>
            <Button x:Name="HistoryBtn" Content="历史记录" Click="HistoryBtn_Click"
                    CornerRadius="8" Padding="16,8" FontSize="13"/>
            <Border Width="1" Background="{StaticResource DividerBrush}" Margin="8,4"/>
            <Button x:Name="ClearBtn" Content="清空本次" Click="ClearBtn_Click"
                    CornerRadius="8" Padding="16,8" FontSize="13"/>
        </StackPanel>

        <!-- Log content -->
        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" CornerRadius="12"
                BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" Padding="16">
            <Grid>
                <!-- Current execution log (color-coded) -->
                <ScrollViewer x:Name="CurrentLogScroll" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="CurrentLogList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Text}" FontFamily="Cascadia Code,Consolas"
                                           FontSize="12" Foreground="{Binding Color}" Margin="0,1"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- History list -->
                <ScrollViewer x:Name="HistoryScroll" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <ItemsControl x:Name="HistoryList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource SurfaceElevatedBrush}" CornerRadius="6"
                                        Padding="12,8" Margin="0,0,0,4">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Timestamp}"
                                                   Foreground="{StaticResource SubtleTextBrush}"
                                                   FontSize="11" FontFamily="Cascadia Code,Consolas"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding ProcessName}"
                                                   Foreground="{StaticResource BodyTextBrush}"
                                                   FontSize="13" VerticalAlignment="Center"/>
                                        <Border Grid.Column="2" Style="{StaticResource TagBadgeStyle}"
                                                Background="{Binding ActionBg}" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Action}" Foreground="{StaticResource BodyTextBrush}" FontSize="11"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Empty state -->
                <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                    <FontIcon Glyph="&#xE8FD;" FontSize="40" Foreground="{StaticResource EmptyIconBrush}"
                              HorizontalAlignment="Center"/>
                    <TextBlock x:Name="EmptyText" Text="暂无日志"
                               Foreground="{StaticResource MutedTextBrush}" FontSize="14"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
