<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="OneClickClose.WinUI.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <ScrollViewer>
        <StackPanel Spacing="16" Padding="8" MaxWidth="800">
            <TextBlock Text="设置" Style="{StaticResource PageTitleStyle}"/>

            <!-- Timeouts -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="16">
                    <TextBlock Text="超时设置" Style="{StaticResource SectionTitleStyle}"/>

                    <StackPanel Spacing="6">
                        <TextBlock Text="等待进程退出（秒）" FontSize="13"
                                   Foreground="{StaticResource MutedTextBrush}"/>
                        <NumberBox x:Name="WaitSecondsBox" Minimum="1" Maximum="60" Value="5"
                                   SpinButtonPlacementMode="Inline" Width="160" HorizontalAlignment="Left"/>
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="温和关闭超时（秒）" FontSize="13"
                                   Foreground="{StaticResource MutedTextBrush}"/>
                        <NumberBox x:Name="GracefulTimeoutBox" Minimum="1" Maximum="60" Value="5"
                                   SpinButtonPlacementMode="Inline" Width="160" HorizontalAlignment="Left"/>
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="查询结束会话超时（秒）" FontSize="13"
                                   Foreground="{StaticResource MutedTextBrush}"/>
                        <NumberBox x:Name="QueryTimeoutBox" Minimum="1" Maximum="30" Value="3"
                                   SpinButtonPlacementMode="Inline" Width="160" HorizontalAlignment="Left"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Process Lists -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="16">
                    <TextBlock Text="进程名单" Style="{StaticResource SectionTitleStyle}"/>

                    <StackPanel Spacing="6">
                        <TextBlock Text="目标进程（每行一个进程名，不含.exe）" FontSize="13"
                                   Foreground="{StaticResource MutedTextBrush}"/>
                        <TextBox x:Name="TargetNamesBox" AcceptsReturn="True" TextWrapping="Wrap"
                                 Height="120" FontFamily="Cascadia Code,Consolas" FontSize="12"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="保护进程（每行一个，这些进程不会被关闭）" FontSize="13"
                                   Foreground="{StaticResource MutedTextBrush}"/>
                        <TextBox x:Name="ProtectedNamesBox" AcceptsReturn="True" TextWrapping="Wrap"
                                 Height="120" FontFamily="Cascadia Code,Consolas" FontSize="12"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="强制清理名单（每行一个，无窗口的目标进程将被强制终止）" FontSize="13"
                                   Foreground="{StaticResource MutedTextBrush}"/>
                        <TextBox x:Name="ForceNamesBox" AcceptsReturn="True" TextWrapping="Wrap"
                                 Height="80" FontFamily="Cascadia Code,Consolas" FontSize="12"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Auto Cleanup Triggers -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="16">
                    <TextBlock Text="自动清理" Style="{StaticResource SectionTitleStyle}"/>

                    <StackPanel Spacing="6">
                        <ToggleSwitch x:Name="ShutdownCleanupToggle" Header="关机前自动清理"
                                      OffContent="关闭" OnContent="开启"/>
                        <TextBlock Text="在收到系统关机信号时，自动执行清理流程"
                                   FontSize="12" Foreground="{StaticResource SubtleTextBrush}" Margin="32,0,0,0"/>
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <ToggleSwitch x:Name="IdleCleanupToggle" Header="空闲时自动清理"
                                      OffContent="关闭" OnContent="开启"/>
                        <TextBlock Text="鼠标键盘无操作超过指定时间后自动清理"
                                   FontSize="12" Foreground="{StaticResource SubtleTextBrush}" Margin="32,0,0,0"/>
                        <NumberBox x:Name="IdleMinutesBox" Minimum="5" Maximum="120" Value="30"
                                   SpinButtonPlacementMode="Inline" Width="160" HorizontalAlignment="Left"
                                   Margin="32,0,0,0"/>
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <ToggleSwitch x:Name="ScheduledCleanupToggle" Header="定时清理"
                                      OffContent="关闭" OnContent="开启"/>
                        <TextBlock Text="每天在指定时间自动执行清理"
                                   FontSize="12" Foreground="{StaticResource SubtleTextBrush}" Margin="32,0,0,0"/>
                        <TimePicker x:Name="ScheduledTimePicker" HorizontalAlignment="Left" Margin="32,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Import/Export -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="16">
                    <TextBlock Text="配置管理" Style="{StaticResource SectionTitleStyle}"/>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button x:Name="ExportConfigBtn" Click="ExportConfigBtn_Click"
                                Style="{StaticResource SubtleButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8DA;" FontSize="14"/>
                                <TextBlock Text="导出配置" Foreground="{StaticResource BodyTextBrush}"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="ImportConfigBtn" Click="ImportConfigBtn_Click"
                                Style="{StaticResource SubtleButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8B5;" FontSize="14"/>
                                <TextBlock Text="导入配置" Foreground="{StaticResource BodyTextBrush}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Actions -->
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button x:Name="SaveButton" Click="SaveButton_Click"
                        Style="{StaticResource PrimaryButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE74E;" FontSize="14"/>
                        <TextBlock Text="保存配置"/>
                    </StackPanel>
                </Button>
                <Button x:Name="ResetButton" Click="ResetButton_Click"
                        Style="{StaticResource SubtleButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE7EE;" FontSize="14"/>
                        <TextBlock Text="恢复默认" Foreground="{StaticResource BodyTextBrush}"/>
                    </StackPanel>
                </Button>
                <Button x:Name="OpenConfigBtn" Click="OpenConfigBtn_Click"
                        Style="{StaticResource SubtleButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8DA;" FontSize="14"/>
                        <TextBlock Text="打开配置文件" Foreground="{StaticResource BodyTextBrush}"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Status -->
            <Border x:Name="StatusPanel" CornerRadius="8" Padding="16"
                    Visibility="Collapsed">
                <TextBlock x:Name="StatusText" FontSize="14" TextWrapping="Wrap"/>
            </Border>

            <!-- About -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Text="关于" Style="{StaticResource SectionTitleStyle}"/>
                    <TextBlock Text="一键关闭后台软件 - WinUI 3 版本" FontSize="13"
                               Foreground="{StaticResource BodyTextBrush}"/>
                    <TextBlock Text="基于 Windows App SDK 2.2 / .NET 9" FontSize="13"
                               Foreground="{StaticResource SubtleTextBrush}"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
