<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="OneClickClose.WinUI.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <Page.Resources>
        <Style x:Key="AccentColorButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="MinWidth" Value="38"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="CornerRadius" Value="19"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </Page.Resources>

    <ScrollViewer x:Name="SettingsScrollViewer"
                  HorizontalScrollMode="Disabled"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <Grid x:Name="SettingsRootGrid" Padding="4,0,12,18" ColumnSpacing="18" RowSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="SettingsSideColumn" Width="300"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Spacing="14">
                <Border Style="{StaticResource HeroGroupBadgeStyle}" Padding="16,12" HorizontalAlignment="Stretch">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE946;" FontSize="16" Foreground="{StaticResource AccentLightBrush}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1"
                                   Text="所有设置仅保存在本机，不会上传到任何服务器。"
                                   Foreground="{StaticResource BodyTextBrush}"
                                   FontSize="13"
                                   TextTrimming="CharacterEllipsis"/>
                    </Grid>
                </Border>

                <Grid x:Name="SettingsCardsGrid" ColumnSpacing="14" RowSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition x:Name="SettingsCardsSecondColumn" Width="1*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Style="{StaticResource CardBorderStyle}" Padding="18" MinHeight="230">
                        <StackPanel Spacing="16">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE790;" FontSize="18" Foreground="{StaticResource TitleTextBrush}"/>
                                <TextBlock Text="外观" Foreground="{StaticResource TitleTextBrush}" FontSize="16" FontWeight="SemiBold"/>
                            </StackPanel>

                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="应用主题" Foreground="{StaticResource MutedTextBrush}" FontSize="13" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
                                    <Border Background="{StaticResource CyanSoftBrush}" BorderBrush="{StaticResource AccentLightBrush}" BorderThickness="1" CornerRadius="10" Padding="10,5">
                                        <TextBlock Text="右上角切换" Foreground="{StaticResource BodyTextBrush}" FontSize="12" FontWeight="SemiBold"/>
                                    </Border>
                                    <TextBlock Text="支持深色 / 浅色" Foreground="{StaticResource SubtleTextBrush}" FontSize="12" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>

                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="强调色" Foreground="{StaticResource MutedTextBrush}" FontSize="13" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Button x:Name="AccentBlueButton"
                                            Tag="blue"
                                            Style="{StaticResource AccentColorButtonStyle}"
                                            Click="AccentColorButton_Click"
                                            ToolTipService.ToolTip="蓝色"
                                            AutomationProperties.Name="强调色：蓝色">
                                        <Grid Width="30" Height="30">
                                            <Ellipse Fill="#2F7BFF"/>
                                            <FontIcon x:Name="AccentBlueCheck" Glyph="&#xE73E;" FontSize="12" Foreground="White" Visibility="Collapsed"/>
                                        </Grid>
                                    </Button>
                                    <Button x:Name="AccentPurpleButton"
                                            Tag="purple"
                                            Style="{StaticResource AccentColorButtonStyle}"
                                            Click="AccentColorButton_Click"
                                            ToolTipService.ToolTip="紫色"
                                            AutomationProperties.Name="强调色：紫色">
                                        <Grid Width="30" Height="30">
                                            <Ellipse Fill="#8B5CF6"/>
                                            <FontIcon x:Name="AccentPurpleCheck" Glyph="&#xE73E;" FontSize="12" Foreground="White" Visibility="Collapsed"/>
                                        </Grid>
                                    </Button>
                                    <Button x:Name="AccentCyanButton"
                                            Tag="cyan"
                                            Style="{StaticResource AccentColorButtonStyle}"
                                            Click="AccentColorButton_Click"
                                            ToolTipService.ToolTip="青色"
                                            AutomationProperties.Name="强调色：青色">
                                        <Grid Width="30" Height="30">
                                            <Ellipse Fill="#38BDF8"/>
                                            <FontIcon x:Name="AccentCyanCheck" Glyph="&#xE73E;" FontSize="12" Foreground="White" Visibility="Collapsed"/>
                                        </Grid>
                                    </Button>
                                    <Button x:Name="AccentGreenButton"
                                            Tag="green"
                                            Style="{StaticResource AccentColorButtonStyle}"
                                            Click="AccentColorButton_Click"
                                            ToolTipService.ToolTip="绿色"
                                            AutomationProperties.Name="强调色：绿色">
                                        <Grid Width="30" Height="30">
                                            <Ellipse Fill="#38E07B"/>
                                            <FontIcon x:Name="AccentGreenCheck" Glyph="&#xE73E;" FontSize="12" Foreground="White" Visibility="Collapsed"/>
                                        </Grid>
                                    </Button>
                                    <Button x:Name="AccentOrangeButton"
                                            Tag="orange"
                                            Style="{StaticResource AccentColorButtonStyle}"
                                            Click="AccentColorButton_Click"
                                            ToolTipService.ToolTip="橙色"
                                            AutomationProperties.Name="强调色：橙色">
                                        <Grid Width="30" Height="30">
                                            <Ellipse Fill="#F59E0B"/>
                                            <FontIcon x:Name="AccentOrangeCheck" Glyph="&#xE73E;" FontSize="12" Foreground="White" Visibility="Collapsed"/>
                                        </Grid>
                                    </Button>
                                    <Button x:Name="AccentRedButton"
                                            Tag="red"
                                            Style="{StaticResource AccentColorButtonStyle}"
                                            Click="AccentColorButton_Click"
                                            ToolTipService.ToolTip="红色"
                                            AutomationProperties.Name="强调色：红色">
                                        <Grid Width="30" Height="30">
                                            <Ellipse Fill="#FF5252"/>
                                            <FontIcon x:Name="AccentRedCheck" Glyph="&#xE73E;" FontSize="12" Foreground="White" Visibility="Collapsed"/>
                                        </Grid>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="界面密度" Foreground="{StaticResource MutedTextBrush}" FontSize="13" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1"
                                           Text="使用紧凑卡片布局，适合快速扫视。"
                                           Foreground="{StaticResource SubtleTextBrush}"
                                           FontSize="12"
                                           TextWrapping="Wrap"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border x:Name="ScanCard" Grid.Column="1" Style="{StaticResource CardBorderStyle}" Padding="18" MinHeight="230">
                        <StackPanel Spacing="14">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE721;" FontSize="18" Foreground="{StaticResource TitleTextBrush}"/>
                                <TextBlock Text="扫描" Foreground="{StaticResource TitleTextBrush}" FontSize="16" FontWeight="SemiBold"/>
                            </StackPanel>

                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="自动检测用户软件" Foreground="{StaticResource BodyTextBrush}" FontSize="13" FontWeight="SemiBold"/>
                                    <TextBlock Text="将用户路径、窗口和资源占用明显的进程纳入候选" Foreground="{StaticResource SubtleTextBrush}" FontSize="11" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ToggleSwitch x:Name="AutoDetectUserAppsToggle" Grid.Column="1" OnContent="" OffContent="" MinWidth="54" VerticalAlignment="Center"/>
                            </Grid>

                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="关机清障规则" Foreground="{StaticResource BodyTextBrush}" FontSize="13" FontWeight="SemiBold"/>
                                    <TextBlock Text="凡是可能阻碍关机的用户软件都纳入关闭候选，系统进程和白名单仍受保护" Foreground="{StaticResource SubtleTextBrush}" FontSize="11" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ToggleSwitch x:Name="CloseShutdownBlockingAppsToggle" Grid.Column="1" OnContent="" OffContent="" MinWidth="54" VerticalAlignment="Center"/>
                            </Grid>

                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="128"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="候选内存阈值" Foreground="{StaticResource BodyTextBrush}" FontSize="13" FontWeight="SemiBold"/>
                                    <TextBlock Text="超过阈值的后台进程更容易进入候选" Foreground="{StaticResource SubtleTextBrush}" FontSize="11" TextWrapping="Wrap"/>
                                </StackPanel>
                                <NumberBox x:Name="CandidateMemoryThresholdBox"
                                           Grid.Column="1"
                                           Minimum="32"
                                           Maximum="4096"
                                           Value="128"
                                           SpinButtonPlacementMode="Compact"
                                           HorizontalAlignment="Stretch"/>
                            </Grid>

                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="128"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="扫描等待间隔" Foreground="{StaticResource BodyTextBrush}" FontSize="13" FontWeight="SemiBold"/>
                                    <TextBlock Text="关闭后等待进程自然退出的时间" Foreground="{StaticResource SubtleTextBrush}" FontSize="11" TextWrapping="Wrap"/>
                                </StackPanel>
                                <NumberBox x:Name="WaitSecondsBox"
                                           Grid.Column="1"
                                           Minimum="1"
                                           Maximum="60"
                                           Value="5"
                                           SpinButtonPlacementMode="Compact"
                                           HorizontalAlignment="Stretch"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border x:Name="SafetyCard" Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="18" MinHeight="230">
                        <StackPanel Spacing="14">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE72E;" FontSize="18" Foreground="{StaticResource TitleTextBrush}"/>
                                <TextBlock Text="安全策略" Foreground="{StaticResource TitleTextBrush}" FontSize="16" FontWeight="SemiBold"/>
                            </StackPanel>

                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="温和关闭失败后安全强制结束" Foreground="{StaticResource BodyTextBrush}" FontSize="13" FontWeight="SemiBold"/>
                                    <TextBlock Text="仅对低风险候选或强制清理名单生效" Foreground="{StaticResource SubtleTextBrush}" FontSize="11" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ToggleSwitch x:Name="ForceAfterGracefulFailureToggle" Grid.Column="1" OnContent="" OffContent="" MinWidth="54" VerticalAlignment="Center"/>
                            </Grid>

                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="128"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="温和关闭超时" Foreground="{StaticResource BodyTextBrush}" FontSize="13" FontWeight="SemiBold"/>
                                    <TextBlock Text="发送关闭请求后的等待时间" Foreground="{StaticResource SubtleTextBrush}" FontSize="11" TextWrapping="Wrap"/>
                                </StackPanel>
                                <NumberBox x:Name="GracefulTimeoutBox"
                                           Grid.Column="1"
                                           Minimum="1"
                                           Maximum="60"
                                           Value="5"
                                           SpinButtonPlacementMode="Compact"
                                           HorizontalAlignment="Stretch"/>
                            </Grid>

                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="128"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="结束会话提示超时" Foreground="{StaticResource BodyTextBrush}" FontSize="13" FontWeight="SemiBold"/>
                                    <TextBlock Text="用于 WM_QUERYENDSESSION 阶段" Foreground="{StaticResource SubtleTextBrush}" FontSize="11" TextWrapping="Wrap"/>
                                </StackPanel>
                                <NumberBox x:Name="QueryTimeoutBox"
                                           Grid.Column="1"
                                           Minimum="1"
                                           Maximum="30"
                                           Value="3"
                                           SpinButtonPlacementMode="Compact"
                                           HorizontalAlignment="Stretch"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border x:Name="LearningCard" Grid.Row="1" Grid.Column="1" Style="{StaticResource CardBorderStyle}" Padding="18" MinHeight="230">
                        <StackPanel Spacing="14">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE82D;" FontSize="18" Foreground="{StaticResource TitleTextBrush}"/>
                                <TextBlock Text="本地学习" Foreground="{StaticResource TitleTextBrush}" FontSize="16" FontWeight="SemiBold"/>
                            </StackPanel>

                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="习惯建议" Foreground="{StaticResource BodyTextBrush}" FontSize="13" FontWeight="SemiBold"/>
                                    <TextBlock Text="根据确认关闭、取消和跳过记录生成本机建议" Foreground="{StaticResource SubtleTextBrush}" FontSize="11" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Border Grid.Column="1" Background="{StaticResource SafeSoftBrush}" CornerRadius="9" Padding="10,4" VerticalAlignment="Center">
                                    <TextBlock Text="已启用" Foreground="{StaticResource SafeBrush}" FontSize="12" FontWeight="SemiBold"/>
                                </Border>
                            </Grid>

                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="重置学习数据" Foreground="{StaticResource BodyTextBrush}" FontSize="13" FontWeight="SemiBold"/>
                                    <TextBlock Text="清除本地习惯计数，保留清理历史" Foreground="{StaticResource SubtleTextBrush}" FontSize="11" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Button Grid.Column="1" Click="ResetLearning_Click" Style="{StaticResource SubtleButtonStyle}" Padding="16,7" VerticalAlignment="Center">
                                    <TextBlock Text="重置" Foreground="{StaticResource BodyTextBrush}" FontWeight="SemiBold"/>
                                </Button>
                            </Grid>

                            <Border Background="{StaticResource CyanSoftBrush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="10" Padding="12">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE785;" FontSize="17" Foreground="{StaticResource AccentLightBrush}" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Text="隐私说明" Foreground="{StaticResource BodyTextBrush}" FontSize="12" FontWeight="SemiBold"/>
                                        <TextBlock Text="学习数据只保存在本机，不会收集或上传进程历史。" Foreground="{StaticResource SubtleTextBrush}" FontSize="11" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <FontIcon Grid.Column="2" Glyph="&#xE930;" FontSize="18" Foreground="{StaticResource SafeBrush}" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Style="{StaticResource CardBorderStyle}" Padding="18">
                    <StackPanel Spacing="14">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE8FD;" FontSize="18" Foreground="{StaticResource TitleTextBrush}"/>
                            <TextBlock Text="进程名单" Foreground="{StaticResource TitleTextBrush}" FontSize="16" FontWeight="SemiBold"/>
                        </StackPanel>

                        <Grid x:Name="ProcessListsGrid" ColumnSpacing="12" RowSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition x:Name="ProcessListsSecondColumn" Width="1*"/>
                                <ColumnDefinition x:Name="ProcessListsThirdColumn" Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Spacing="6">
                                <TextBlock Text="目标进程" Foreground="{StaticResource MutedTextBrush}" FontSize="12"/>
                                <TextBox x:Name="TargetNamesBox"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         Height="116"
                                         FontFamily="Cascadia Code,Consolas"
                                         FontSize="12"
                                         Style="{StaticResource SubtleTextBoxStyle}"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                            </StackPanel>

                            <StackPanel x:Name="ProtectedNamesPanel" Grid.Column="1" Spacing="6">
                                <TextBlock Text="保护进程" Foreground="{StaticResource MutedTextBrush}" FontSize="12"/>
                                <TextBox x:Name="ProtectedNamesBox"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         Height="116"
                                         FontFamily="Cascadia Code,Consolas"
                                         FontSize="12"
                                         Style="{StaticResource SubtleTextBoxStyle}"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                            </StackPanel>

                            <StackPanel x:Name="ForceNamesPanel" Grid.Column="2" Spacing="6">
                                <TextBlock Text="强制清理名单" Foreground="{StaticResource MutedTextBrush}" FontSize="12"/>
                                <TextBox x:Name="ForceNamesBox"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         Height="116"
                                         FontFamily="Cascadia Code,Consolas"
                                         FontSize="12"
                                         Style="{StaticResource SubtleTextBoxStyle}"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorderStyle}" Padding="18">
                    <StackPanel Spacing="14">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE713;" FontSize="18" Foreground="{StaticResource TitleTextBrush}"/>
                            <TextBlock Text="高级" Foreground="{StaticResource TitleTextBrush}" FontSize="16" FontWeight="SemiBold"/>
                        </StackPanel>

                        <Grid ColumnSpacing="12" RowSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="配置文件位置" Foreground="{StaticResource BodyTextBrush}" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="应用设置和名单的存储位置" Foreground="{StaticResource SubtleTextBrush}" FontSize="11"/>
                            </StackPanel>
                            <TextBox x:Name="ConfigPathBox" Grid.Column="1" IsReadOnly="True" Style="{StaticResource SubtleTextBoxStyle}" MinHeight="38"/>
                            <Button Grid.Column="2" x:Name="OpenConfigBtn" Click="OpenConfigBtn_Click" Style="{StaticResource SubtleButtonStyle}" MinHeight="38" Padding="18,8">
                                <TextBlock Text="打开文件" Foreground="{StaticResource BodyTextBrush}" FontWeight="SemiBold"/>
                            </Button>

                            <StackPanel Grid.Row="1" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="导入 / 导出" Foreground="{StaticResource BodyTextBrush}" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="备份或迁移当前配置" Foreground="{StaticResource SubtleTextBrush}" FontSize="11"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="10">
                                <Button x:Name="ExportConfigBtn" Click="ExportConfigBtn_Click" Style="{StaticResource SubtleButtonStyle}" MinHeight="38" Padding="18,8">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE74E;" FontSize="14" Foreground="{StaticResource AccentLightBrush}"/>
                                        <TextBlock Text="导出配置" Foreground="{StaticResource BodyTextBrush}" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="ImportConfigBtn" Click="ImportConfigBtn_Click" Style="{StaticResource SubtleButtonStyle}" MinHeight="38" Padding="18,8">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE8B5;" FontSize="14" Foreground="{StaticResource BodyTextBrush}"/>
                                        <TextBlock Text="导入配置" Foreground="{StaticResource BodyTextBrush}" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="保存与恢复" Foreground="{StaticResource BodyTextBrush}" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="写入配置或恢复默认值" Foreground="{StaticResource SubtleTextBrush}" FontSize="11"/>
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="10">
                                <Button x:Name="SaveButton" Click="SaveButton_Click" Style="{StaticResource PrimaryButtonStyle}" MinHeight="40" Padding="22,9">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE74E;" FontSize="14" Foreground="White"/>
                                        <TextBlock Text="保存配置" Foreground="White" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="ResetButton" Click="ResetButton_Click" Style="{StaticResource SubtleButtonStyle}" MinHeight="40" Padding="18,9">
                                    <TextBlock Text="恢复默认" Foreground="{StaticResource BodyTextBrush}" FontWeight="SemiBold"/>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <Border x:Name="StatusPanel" CornerRadius="10" Padding="12" Visibility="Collapsed">
                            <TextBlock x:Name="StatusText" FontSize="13" TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel x:Name="SettingsSidePanel" Grid.Column="1" Spacing="14">
                <Border Style="{StaticResource CardBorderStyle}" Padding="18">
                    <StackPanel Spacing="14">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid Width="58" Height="58" VerticalAlignment="Top">
                                <Ellipse Fill="{StaticResource PrimaryGradientBrush}"/>
                                <FontIcon Glyph="&#xE945;" FontSize="28" Foreground="White"/>
                            </Grid>
                            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="关于 OneClickClose" Foreground="{StaticResource TitleTextBrush}" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock Text="本地优先的系统优化工具，安全、可解释、可控。" Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                        <Border Height="1" Background="{StaticResource DividerBrush}"/>
                        <StackPanel Spacing="5">
                            <TextBlock x:Name="VersionText" Text="版本：v1.0.0" Foreground="{StaticResource BodyTextBrush}" FontSize="13" FontWeight="SemiBold"/>
                            <Button Click="OpenWebsite_Click" Background="Transparent" BorderThickness="0" Padding="0" HorizontalAlignment="Left">
                                <TextBlock Text="检查更新" Foreground="{StaticResource AccentLightBrush}" FontSize="13" FontWeight="SemiBold"/>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorderStyle}" Padding="18">
                    <StackPanel Spacing="14">
                        <TextBlock Text="帮助与支持" Foreground="{StaticResource TitleTextBrush}" FontSize="16" FontWeight="SemiBold"/>
                        <Border Height="1" Background="{StaticResource DividerBrush}"/>

                        <Button Click="OpenReadme_Click" Background="Transparent" BorderThickness="0" Padding="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                            <Grid MinHeight="34">
                                <TextBlock Text="使用文档" Foreground="{StaticResource BodyTextBrush}" FontSize="13" VerticalAlignment="Center"/>
                                <FontIcon Glyph="&#xE8A7;" FontSize="13" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>

                        <Button Click="OpenDevelopmentDocs_Click" Background="Transparent" BorderThickness="0" Padding="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                            <Grid MinHeight="34">
                                <TextBlock Text="常见问题" Foreground="{StaticResource BodyTextBrush}" FontSize="13" VerticalAlignment="Center"/>
                                <FontIcon Glyph="&#xE8A7;" FontSize="13" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>

                        <Button Click="OpenFeedback_Click" Background="Transparent" BorderThickness="0" Padding="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                            <Grid MinHeight="34">
                                <TextBlock Text="反馈与建议" Foreground="{StaticResource BodyTextBrush}" FontSize="13" VerticalAlignment="Center"/>
                                <FontIcon Glyph="&#xE8A7;" FontSize="13" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorderStyle}" Padding="18">
                    <StackPanel Spacing="14">
                        <TextBlock Text="系统信息" Foreground="{StaticResource TitleTextBrush}" FontSize="16" FontWeight="SemiBold"/>
                        <StackPanel Spacing="6">
                            <TextBlock x:Name="OsInfoText" Text="Windows" Foreground="{StaticResource BodyTextBrush}" FontSize="13" TextWrapping="Wrap"/>
                            <TextBlock x:Name="CpuInfoText" Text="CPU" Foreground="{StaticResource BodyTextBrush}" FontSize="13" TextWrapping="Wrap"/>
                            <TextBlock x:Name="MemoryInfoText" Text="内存" Foreground="{StaticResource BodyTextBrush}" FontSize="13" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button Click="CopySystemInfo_Click" Style="{StaticResource SubtleButtonStyle}" HorizontalAlignment="Stretch" MinHeight="38">
                            <TextBlock Text="复制信息" Foreground="{StaticResource BodyTextBrush}" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        </Button>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
