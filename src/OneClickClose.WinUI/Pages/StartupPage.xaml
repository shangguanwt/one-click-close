<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="OneClickClose.WinUI.Pages.StartupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid Padding="8" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title + count badge -->
        <StackPanel Orientation="Horizontal" Spacing="12">
            <TextBlock Text="自启管理" Style="{StaticResource PageTitleStyle}"/>
            <Border x:Name="CountBadge" Background="{StaticResource SurfaceElevatedBrush}"
                    CornerRadius="4" Padding="8,3" VerticalAlignment="Center" Visibility="Collapsed"
                    BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1">
                <TextBlock x:Name="CountText" Foreground="{StaticResource BodyTextBrush}"
                           FontSize="12" FontWeight="Medium"/>
            </Border>
        </StackPanel>

        <!-- Toolbar: Scan button + filter tabs -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
            <!-- Scan button -->
            <Button x:Name="ScanBtn" Click="ScanBtn_Click" Style="{StaticResource SubtleButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE721;" FontSize="14"/>
                    <TextBlock Text="扫描启动项"/>
                </StackPanel>
            </Button>

            <Border Width="1" Background="{StaticResource DividerBrush}" Margin="4,4"/>

            <!-- Filter buttons -->
            <Button x:Name="FilterAllBtn" Content="全部" Click="FilterAllBtn_Click"
                    Style="{StaticResource SubtleButtonStyle}" FontWeight="SemiBold"/>
            <Button x:Name="FilterRegistryBtn" Content="注册表" Click="FilterRegistryBtn_Click"
                    Style="{StaticResource SubtleButtonStyle}"/>
            <Button x:Name="FilterFolderBtn" Content="启动文件夹" Click="FilterFolderBtn_Click"
                    Style="{StaticResource SubtleButtonStyle}"/>
            <Button x:Name="FilterTaskBtn" Content="计划任务" Click="FilterTaskBtn_Click"
                    Style="{StaticResource SubtleButtonStyle}"/>
        </StackPanel>

        <!-- Startup items list -->
        <ScrollViewer Grid.Row="2" x:Name="ListScroll">
            <ItemsControl x:Name="ItemsList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8"
                                BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1"
                                Padding="16,12" Margin="0,0,0,4">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- ToggleSwitch: enable / disable -->
                                <ToggleSwitch Grid.Column="0"
                                              IsOn="{Binding IsEnabled, Mode=TwoWay}"
                                              Toggled="ItemToggle_Toggled"
                                              Tag="{Binding}"
                                              OnContent=""
                                              OffContent=""
                                              VerticalAlignment="Center"/>

                                <!-- Name + command -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="{Binding Name}"
                                               Foreground="{StaticResource TitleTextBrush}"
                                               FontSize="14" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Command}"
                                               Foreground="{StaticResource SubtleTextBrush}"
                                               FontSize="11" FontFamily="Cascadia Code,Consolas"
                                               TextTrimming="CharacterEllipsis"
                                               MaxLines="1"/>
                                </StackPanel>

                                <!-- Source badge -->
                                <Border Grid.Column="2" Style="{StaticResource TagBadgeStyle}"
                                        VerticalAlignment="Center"
                                        Background="{Binding SourceBadgeBg}">
                                    <TextBlock Text="{Binding Source}"
                                               Foreground="{Binding SourceBadgeFg}" FontSize="11"/>
                                </Border>

                                <!-- Locate button -->
                                <Button Grid.Column="3" Content="定位"
                                        Style="{StaticResource SubtleButtonStyle}"
                                        Click="LocateBtn_Click" Tag="{Binding}"
                                        VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Empty state (no scan yet) -->
        <Border x:Name="EmptyState" Grid.Row="2" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1"
                CornerRadius="12" Padding="40" HorizontalAlignment="Stretch" VerticalAlignment="Top">
            <StackPanel Spacing="8" HorizontalAlignment="Center">
                <FontIcon Glyph="&#xE72E;" FontSize="40" Foreground="{StaticResource EmptyIconBrush}"
                          HorizontalAlignment="Center"/>
                <TextBlock x:Name="EmptyText" Text="点击「扫描启动项」查看开机启动列表"
                           Foreground="{StaticResource MutedTextBrush}" FontSize="14"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- No results state -->
        <Border x:Name="NoResultsState" Grid.Row="2" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1"
                CornerRadius="12" Padding="40" HorizontalAlignment="Stretch" VerticalAlignment="Top"
                Visibility="Collapsed">
            <StackPanel Spacing="8" HorizontalAlignment="Center">
                <FontIcon Glyph="&#xE721;" FontSize="40" Foreground="{StaticResource EmptyIconBrush}"
                          HorizontalAlignment="Center"/>
                <TextBlock Text="该分类下没有启动项" Foreground="{StaticResource MutedTextBrush}"
                           FontSize="14" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Status InfoBar -->
        <InfoBar x:Name="StatusInfoBar" Grid.Row="2"
                 IsOpen="False"
                 VerticalAlignment="Bottom"
                 HorizontalAlignment="Stretch"
                 Margin="0,0,0,8"/>
    </Grid>
</Page>
